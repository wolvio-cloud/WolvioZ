# Copy this to .env and fill in real values
# IMPORTANT: .env is gitignored — never commit real keys

# ─── LiteLLM ───────────────────────────────────────────────────────────────
# Single master key used by both LiteLLM and Open WebUI
# Must be identical in all three places: .env, docker-compose.yml, litellm_config.yaml
LITELLM_MASTER_KEY=sk-your-master-key-here

# ─── LLM Provider API Keys ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ─── Open WebUI ────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=your-webui-secret-here

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
