# Copy to .env and fill in real values
# .env is gitignored — never commit real keys

# ─── LiteLLM master key (used by both LiteLLM and Open WebUI) ───────────────
# Generate with: openssl rand -hex 32
# Must be the same in all three: .env, docker-compose.yml, litellm_config.yaml
LITELLM_MASTER_KEY=sk-your-master-key-here

# ─── Open WebUI session secret ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=your-webui-secret-here

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Network ─────────────────────────────────────────────────────────────────
SERVER_IP=159.65.153.81
# Uncomment and set to enable HTTPS via Let's Encrypt (Caddy handles it auto):
# DOMAIN=ai.yourdomain.com
