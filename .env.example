# Copy to .env and fill in real values
# .env is gitignored — never commit secrets to version control

# ─── LiteLLM master key ──────────────────────────────────────────────────────
# Set once here — automatically read by all services (LiteLLM + Open WebUI)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-your-master-key-here

# ─── Open WebUI session secret ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=your-webui-secret-here

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ─── Redis ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=your-redis-password-here

# ─── SearXNG (self-hosted web search) ────────────────────────────────────────
# Generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=your-searxng-secret-here

# ─── Network ─────────────────────────────────────────────────────────────────
# Uncomment and set to enable HTTPS via Let's Encrypt (Caddy handles it automatically):
# DOMAIN=ai.yourdomain.com
