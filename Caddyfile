# Wolvio Z — Caddy reverse proxy
# When DOMAIN is set: serves HTTPS with auto Let's Encrypt cert
# When DOMAIN is empty: falls back to :80 (plain HTTP on server IP)
#
# The {$DOMAIN::80} syntax means:
#   - use $DOMAIN env var as the site address if set
#   - fall back to ":80" if $DOMAIN is empty or unset

(security_headers) {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

{$DOMAIN::80} {
  import security_headers
  reverse_proxy open-webui:8080
}
