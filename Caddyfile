# Wolvio Z — Caddy reverse proxy
# HTTP on port 80 (plain IP access).
# To enable HTTPS, replace ":80" with your domain name and redeploy.

:80 {
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  reverse_proxy open-webui:8080
}
